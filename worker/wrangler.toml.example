name = "emplivo-intake"
main = "index.mjs"
compatibility_date = "2026-11-20"

[vars]
ALLOWED_ORIGINS = "https://vadisimus.github.io,https://www.emplivo.com.ua"
PRIVACY_VERSION = "v1"
EMPLIVO_VACANCY_IDS = ""

[[d1_databases]]
binding = "DB"
database_name = "emplivo-intake"
database_id = "REPLACE_WITH_D1_ID"

[[ratelimits]]
name = "INTAKE_LIMIT"
namespace_id = "1001"
simple = { limit = 6, period = 60 }

[triggers]
crons = ["17 2 * * *"]

[observability]
enabled = false
